# ==============================================================================
# Tade Boxing Club - Environment Variables Configuration Template
# ==============================================================================

# Django Secret Key (generate a secure random string for production)
SECRET_KEY=your-production-secret-key-here

# Debug mode (Set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated, e.g. localhost,127.0.0.1,tadebox.vercel.app)
ALLOWED_HOSTS=localhost,127.0.0.1,*.vercel.app

# CSRF Trusted Origins (comma-separated, include your https domain on Vercel)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.vercel.app

# Neon PostgreSQL Database Connection URL
# Example: postgresql://neondb_owner:password@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudinary Storage Configuration for Payment Screenshots
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# Development Month Simulation (DEVELOPMENT ONLY - strictly ignored if DEBUG=False)
# Override the active subscription month to simulate month changes (e.g. 2026-11)
# Leave empty or commented out to use the real calendar month in Africa/Addis_Ababa
# ==============================================================================
# SIMULATED_SUBSCRIPTION_MONTH=2026-11

